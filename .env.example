# MomentBook Admin — Environment Variables
# =============================================================================
#
# yarn build validates these (src/lib/env.ts): a missing secret, or an http
# admin or API URL in a production build that is not local, fails the build.
#
# Setup:
#   Local dev:  cp .env.example .env  → fill in values below
#   Production: set all variables in Vercel Dashboard >
#               Project Settings > Environment Variables (Production)
#
# =============================================================================

# -------- Required: URLs --------

# Admin site base URL (must be HTTPS in production unless APP_IS_LOCAL=true)
#   Dev:  http://localhost:3200
#   Prod: https://admin.momentbook.app
NEXT_PUBLIC_ADMIN_SITE_URL=

# Backend Nest API base URL (must be HTTPS in production unless APP_IS_LOCAL=true)
#   Dev:  http://127.0.0.1:3001
#   Prod: https://api.momentbook.app
NEXT_PUBLIC_API_BASE_URL=

# Public image CDN origin
#   Dev:  http://127.0.0.1:3001
NEXT_PUBLIC_PUBLIC_IMAGE_ORIGIN=

# API types (dev tool, not read by the app): `yarn generate:api` writes
# src/lib/api/generated/ from API_SPEC_DIR (a directory of <service>.json,
# such as ../momentbook-api/docs/openapi) or API_SPEC_URL (a running API,
# such as http://127.0.0.1:3001). Pass one on the command line.

# -------- Required: Runtime Flags --------

# Application environment: "development" | "production"
#   Dev:  development
#   Prod: production
NEXT_PUBLIC_APP_ENV=

# Allow localhost connection fallbacks: "true" | "false"
#   Dev:  true
#   Prod: false
NEXT_PUBLIC_APP_IS_LOCAL=

# -------- Required: Auth --------

# -------- Required: Secrets (keep out of version control) --------

# Encrypted admin cookie signing secret (64-char hex string recommended)
ADMIN_SESSION_SECRET=
