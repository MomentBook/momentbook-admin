    "clsx": "^2.1.1",
    "jose": "^6.2.2",
    "lucide-react": "1.8.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "nuqs": "2.10.2",
    "openapi-fetch": "0.17.0",
    "radix-ui": "~1.6.7",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "react-hook-form": "^7.84.0",
    "react-is": "19.2.9",
    "recharts": "3.8.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "~1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "19",
    "@types/react-dom": "19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.12"
