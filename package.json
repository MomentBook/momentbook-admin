{
  "name": "momentbook-admin",
  "version": "2.4.4",
  "private": true,
  "packageManager": "yarn@3.6.4",
  "scripts": {
    "dev": "NODE_ENV=development next dev -p 3200",
    "build": "NODE_ENV=production next build",
    "start": "NODE_ENV=production next start -p 3200",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "yarn typecheck && yarn lint && yarn test"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.2",
    "lucide-react": "1.8.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "~1.6.7",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "react-hook-form": "^7.84.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "~1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "19",
    "@types/react-dom": "19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.12"
